# Copy to .env once, then run Docker Compose and the CLI from this directory.
# For an existing database, use its current password. Keep both entries in sync.
# Use URL-safe password characters, or percent-encode them in the database URL.
STOCK_ANALYSER_POSTGRES_PASSWORD=local-development-only
STOCK_ANALYSER_POSTGRES_PORT=5432
STOCK_ANALYSER_DATABASE_URL=postgresql+psycopg://stock_analyser:local-development-only@127.0.0.1:5432/stock_analyser

# Optional: integration tests create/drop disposable databases on this server.
# STOCK_ANALYSER_TEST_DATABASE_URL=postgresql+psycopg://stock_analyser:local-development-only@127.0.0.1:5432/stock_analyser
